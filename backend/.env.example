# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth (JOURNAL_PASSWORD at least 8 characters, SESSION_SECRET at least 32)
JOURNAL_PASSWORD=choose-a-password-here
SESSION_SECRET=replace-with-a-long-random-string-of-32-or-more-characters

# Database: put the database name before the "?"
# For a demo deployment, the name must contain "demo", e.g. journal_demo
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOURCLUSTER.mongodb.net/journal?appName=journal

# Photos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (optional: the journal works without these)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_FAST_MODEL=openai/gpt-oss-20b
AI_SMART_MODEL=openai/gpt-oss-20b
AI_REASONING_EFFORT=low
EMBEDDING_API_KEY=
EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-small-en-v1.5/pipeline/feature-extraction